module HelloWorldTestingggg
  module Models
    type adoption_retrieve_decision_response =
      HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionApproved
      | HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected
      | HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated
      | HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn

    module AdoptionRetrieveDecisionResponse
      extend HelloWorldTestingggg::Internal::Type::Union

      type decision_approved =
        { approved_at: Time, outcome: :approved, conditions: ::Array[String] }

      class DecisionApproved < HelloWorldTestingggg::Internal::Type::BaseModel
        attr_accessor approved_at: Time

        attr_accessor outcome: :approved

        attr_reader conditions: ::Array[String]?

        def conditions=: (::Array[String]) -> ::Array[String]

        def initialize: (
          approved_at: Time,
          ?conditions: ::Array[String],
          ?outcome: :approved
        ) -> void

        def to_hash: -> {
          approved_at: Time,
          outcome: :approved,
          conditions: ::Array[String]
        }
      end

      type decision_rejected =
        {
          outcome: :rejected,
          reason: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected::reason,
          appeal_deadline: Time?
        }

      class DecisionRejected < HelloWorldTestingggg::Internal::Type::BaseModel
        attr_accessor outcome: :rejected

        attr_accessor reason: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected::reason

        attr_accessor appeal_deadline: Time?

        def initialize: (
          reason: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected::reason,
          ?appeal_deadline: Time?,
          ?outcome: :rejected
        ) -> void

        def to_hash: -> {
          outcome: :rejected,
          reason: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected::reason,
          appeal_deadline: Time?
        }

        type reason = :policy | :capacity | :incomplete

        module Reason
          extend HelloWorldTestingggg::Internal::Type::Enum

          POLICY: :policy
          CAPACITY: :capacity
          INCOMPLETE: :incomplete

          def self?.values: -> ::Array[HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionRejected::reason]
        end
      end

      type decision_escalated =
        {
          escalated_to: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo,
          outcome: :escalated,
          review_after: Time
        }

      class DecisionEscalated < HelloWorldTestingggg::Internal::Type::BaseModel
        attr_accessor escalated_to: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo

        attr_accessor outcome: :escalated

        attr_reader review_after: Time?

        def review_after=: (Time) -> Time

        def initialize: (
          escalated_to: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo,
          ?review_after: Time,
          ?outcome: :escalated
        ) -> void

        def to_hash: -> {
          escalated_to: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo,
          outcome: :escalated,
          review_after: Time
        }

        type escalated_to =
          {
            team: String,
            contact: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact
          }

        class EscalatedTo < HelloWorldTestingggg::Internal::Type::BaseModel
          attr_accessor team: String

          attr_reader contact: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact?

          def contact=: (
            HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact
          ) -> HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact

          def initialize: (
            team: String,
            ?contact: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact
          ) -> void

          def to_hash: -> {
            team: String,
            contact: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionEscalated::EscalatedTo::Contact
          }

          type contact = { email: String, hours: String }

          class Contact < HelloWorldTestingggg::Internal::Type::BaseModel
            attr_reader email: String?

            def email=: (String) -> String

            attr_reader hours: String?

            def hours=: (String) -> String

            def initialize: (?email: String, ?hours: String) -> void

            def to_hash: -> { email: String, hours: String }
          end
        end
      end

      type decision_withdrawn =
        {
          outcome: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::outcome,
          withdrawn_by: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::withdrawn_by,
          withdrawn_at: Time
        }

      class DecisionWithdrawn < HelloWorldTestingggg::Internal::Type::BaseModel
        attr_accessor outcome: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::outcome

        attr_accessor withdrawn_by: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::withdrawn_by

        attr_reader withdrawn_at: Time?

        def withdrawn_at=: (Time) -> Time

        def initialize: (
          outcome: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::outcome,
          withdrawn_by: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::withdrawn_by,
          ?withdrawn_at: Time
        ) -> void

        def to_hash: -> {
          outcome: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::outcome,
          withdrawn_by: HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::withdrawn_by,
          withdrawn_at: Time
        }

        type outcome = :withdrawn | :expired

        module Outcome
          extend HelloWorldTestingggg::Internal::Type::Enum

          WITHDRAWN: :withdrawn
          EXPIRED: :expired

          def self?.values: -> ::Array[HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::outcome]
        end

        type withdrawn_by = :applicant | :shelter | :system

        module WithdrawnBy
          extend HelloWorldTestingggg::Internal::Type::Enum

          APPLICANT: :applicant
          SHELTER: :shelter
          SYSTEM: :system

          def self?.values: -> ::Array[HelloWorldTestingggg::Models::AdoptionRetrieveDecisionResponse::DecisionWithdrawn::withdrawn_by]
        end
      end

      def self?.variants: -> ::Array[HelloWorldTestingggg::Models::adoption_retrieve_decision_response]
    end
  end
end
