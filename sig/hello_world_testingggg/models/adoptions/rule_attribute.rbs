module HelloWorldTestingggg
  module Models
    module Adoptions
      type rule_attribute =
        :PET_STATUS
        | :SPECIES
        | :ADOPTER_AGE
        | :REGION
        | :PRIOR_ADOPTIONS
        | :APPLICATION_DATE

      module RuleAttribute
        extend HelloWorldTestingggg::Internal::Type::Enum

        PET_STATUS: :PET_STATUS
        SPECIES: :SPECIES
        ADOPTER_AGE: :ADOPTER_AGE
        REGION: :REGION
        PRIOR_ADOPTIONS: :PRIOR_ADOPTIONS
        APPLICATION_DATE: :APPLICATION_DATE

        def self?.values: -> ::Array[HelloWorldTestingggg::Models::Adoptions::rule_attribute]
      end
    end
  end
end
