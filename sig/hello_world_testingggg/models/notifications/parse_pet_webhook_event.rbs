                first_name: String,
                last_name: String,
                password: String,
                phone: String,
                related_address: HelloWorldTestingggg::Address,
                related_category: top,
                related_customer: top,
                related_money: HelloWorldTestingggg::Money,
                related_order: top,
                related_pet: HelloWorldTestingggg::PetAPI,
                related_shelter: top,
                related_tag: top,
                username: String,
                user_status: Integer
              }

            class Reviewer < HelloWorldTestingggg::Internal::Type::BaseModel
              attr_reader id: Integer?

              def id=: (Integer) -> Integer

              attr_reader email: String?

              def email=: (String) -> String

              attr_reader first_name: String?

              def first_name=: (String) -> String

              attr_reader last_name: String?

              def last_name=: (String) -> String

              attr_reader password: String?

