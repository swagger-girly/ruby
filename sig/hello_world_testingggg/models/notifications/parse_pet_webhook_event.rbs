          type reason = :policy_violation | :duplicate | :"unsafe-content"

          module Reason
            extend HelloWorldTestingggg::Internal::Type::Enum

            POLICY_VIOLATION: :policy_violation
            DUPLICATE: :duplicate
            UNSAFE_CONTENT: :"unsafe-content"

            def self?.values: -> ::Array[HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationRejectedEvent::reason]
          end

          type type_ = :"pet.moderation.rejected"

          module Type
            extend HelloWorldTestingggg::Internal::Type::Enum

            PET_MODERATION_REJECTED: :"pet.moderation.rejected"

            def self?.values: -> ::Array[HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationRejectedEvent::type_]
          end

          type review_note =
            {
              message: String,
              reviewer: HelloWorldTestingggg::Notifications::ParsePetWebhookEvent::PetModerationRejectedEvent::ReviewNote::Reviewer
            }

