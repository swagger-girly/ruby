                ?username: String,
                ?user_status: Integer
              ) -> void

              def to_hash: -> {
                id: Integer,
                email: String,
                first_name: String,
                last_name: String,
                password: String,
                phone: String,
                related_address: HelloWorldTestingggg::Address,
                related_category: top,
                related_customer: top,
                related_money: HelloWorldTestingggg::Money,
                related_order: top,
                related_pet: HelloWorldTestingggg::PetAPI,
                related_shelter: top,
                related_tag: top,
                username: String,
                user_status: Integer
              }
