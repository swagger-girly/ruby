            pet: HelloWorldTestingggg::PetAPI,
            type: HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationApprovedEvent::type_
          }

          type type_ = :"pet.moderation.approved"

          module Type
            extend HelloWorldTestingggg::Internal::Type::Enum

            PET_MODERATION_APPROVED: :"pet.moderation.approved"

            def self?.values: -> ::Array[HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationApprovedEvent::type_]
          end
        end

