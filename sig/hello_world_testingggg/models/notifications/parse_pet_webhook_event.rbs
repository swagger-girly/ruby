        | HelloWorldTestingggg::Notifications::ParsePetWebhookEvent::PetModerationApprovedEvent
        | HelloWorldTestingggg::Notifications::ParsePetWebhookEvent::PetModerationRejectedEvent

      module ParsePetWebhookEvent
        extend HelloWorldTestingggg::Internal::Type::Union

        type pet_moderation_approved_event =
          {
            approved_at: Time,
            pet: HelloWorldTestingggg::PetAPI,
            type: HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationApprovedEvent::type_
          }

        class PetModerationApprovedEvent < HelloWorldTestingggg::Internal::Type::BaseModel
          attr_accessor approved_at: Time

          attr_accessor pet: HelloWorldTestingggg::PetAPI

          attr_accessor type: HelloWorldTestingggg::Models::Notifications::ParsePetWebhookEvent::PetModerationApprovedEvent::type_

          def initialize: (
            approved_at: Time,
