        related_shelter: top,
        related_user: top,
        status: HelloWorldTestingggg::Models::pet_status,
        tags: ::Array[top]
      }

      type acquisition_channel =
        :breeder | :shelter | :surrender | :transfer | String

      module AcquisitionChannel
        extend HelloWorldTestingggg::Internal::Type::Union

        def self?.variants: -> ::Array[HelloWorldTestingggg::Models::PetAPI::acquisition_channel]

        BREEDER: :breeder
        SHELTER: :shelter
        SURRENDER: :surrender
        TRANSFER: :transfer
