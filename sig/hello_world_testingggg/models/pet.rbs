        related_shelter: top,
        related_user: top,
        status: HelloWorldTestingggg::Models::pet_status,
        tags: ::Array[top]
      }

    class PetAPI < HelloWorldTestingggg::Internal::Type::BaseModel
      attr_accessor name: String

      attr_accessor photo_urls: ::Array[String]

