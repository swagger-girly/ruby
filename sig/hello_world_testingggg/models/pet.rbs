        HelloWorldTestingggg::Models::pet_status
      ) -> HelloWorldTestingggg::Models::pet_status

      attr_reader tags: ::Array[top]?

      def tags=: (::Array[top]) -> ::Array[top]

      def initialize: (
        name: String,
        photo_urls: ::Array[String],
        ?id: Integer,
        ?acquisition_channel: HelloWorldTestingggg::Models::PetAPI::acquisition_channel,
        ?category: top,
        ?microchip_id: HelloWorldTestingggg::Models::PetAPI::microchip_id,
        ?related_address: HelloWorldTestingggg::Address,
        ?related_category: top,
        ?related_customer: top,
        ?related_money: HelloWorldTestingggg::Money,
        ?related_order: top,
        ?related_pet: HelloWorldTestingggg::PetAPI,
        ?related_shelter: top,
        ?related_user: top,
        ?status: HelloWorldTestingggg::Models::pet_status,
        ?tags: ::Array[top]
      ) -> void

      def to_hash: -> {
        name: String,
        photo_urls: ::Array[String],
        id: Integer,
        acquisition_channel: HelloWorldTestingggg::Models::PetAPI::acquisition_channel,
        category: top,
        microchip_id: HelloWorldTestingggg::Models::PetAPI::microchip_id,
