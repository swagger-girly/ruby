      ) -> HelloWorldTestingggg::Money

      attr_reader related_order: top?

      def related_order=: (top) -> top

      attr_reader related_pet: HelloWorldTestingggg::PetAPI?

      def related_pet=: (
        HelloWorldTestingggg::PetAPI
      ) -> HelloWorldTestingggg::PetAPI

      attr_reader related_shelter: top?

      def related_shelter=: (top) -> top

      attr_reader related_user: top?

