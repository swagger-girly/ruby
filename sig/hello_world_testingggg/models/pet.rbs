      ) -> HelloWorldTestingggg::Models::PetAPI::acquisition_channel

      attr_reader category: top?

      def category=: (top) -> top

      attr_reader microchip_id: HelloWorldTestingggg::Models::PetAPI::microchip_id?

      def microchip_id=: (
        HelloWorldTestingggg::Models::PetAPI::microchip_id
      ) -> HelloWorldTestingggg::Models::PetAPI::microchip_id

      attr_reader related_address: HelloWorldTestingggg::Address?

      def related_address=: (
